{
  "name": "carromba",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Play carrom online, free, no ads. Physics-driven, vs AI or pass-and-play.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src worker",
    "og": "node scripts/make-og.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name carromba"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "oxlint": "^1.90.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  },
  "overrides": {
    "undici": ">=7.29.0",
    "postcss": ">=8.5.18",
    "sharp": "$sharp"
  }
}
