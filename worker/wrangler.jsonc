{
  // The online rooms backend: one Worker, one Durable Object class, no database.
  // Deployed separately from the Pages site with:
  //   wrangler deploy --config worker/wrangler.jsonc
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "carromba-rooms",
  "main": "index.ts",
  "compatibility_date": "2026-07-09",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [
    {
      // SQLite-backed Durable Objects are the ones included on the free plan.
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ]
}
