# Cloudflare Pages security and caching headers.
# Carromba talks to exactly one thing: the rooms Worker, over a websocket, for
# online play. Everything else is same-origin. Framing is blocked on purpose:
# there is no reason to embed Carromba, and it stops an ad-heavy portal from
# wrapping the game in a frame full of ads.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' wss://carromba-rooms.karthik-e5e.workers.dev; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

# Vite fingerprints these filenames, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
